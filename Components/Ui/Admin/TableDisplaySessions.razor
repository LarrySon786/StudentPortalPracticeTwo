@using StudentPortalPracticeTwo.Database.Models.Degrees
@inject StudentPortalPracticeTwo.Components.Services.Admin.ClassSessionService sessionService
@inject IJSRuntime JS
@rendermode InteractiveServer

<div>
    <input class="form-control" type="text" placeholder="Search sessions..." @oninput="UpdateQuery" />
</div>

<table class="table">
    <thead>
        <th>Session Course</th>
        <th>Instructor</th>
        <th>Start Date/Time</th>
        <th>End Date/Time</th>
        <th></th>
    </thead>
    <tbody>
        @foreach (ClassSession session in queriedSessions)
        {
            <tr>
                <td>@session.Course.Name</td>
                <td>@(session.Instructor is null ? "Unknown" : $"{session.Instructor.FirstName} {session.Instructor.LastName}")</td>
                <td>@session.StartDate @session.StartTime</td>
                <td>@session.EndDate @session.EndTime</td>
                <div>
                    <td><button class="btn btn-primary" type="button" @onclick="() => ToggleEditSessionDialog(session)">Edit/View Session</button></td>
                    <td><button class="btn btn-danger" type="button" @onclick="() => HandleDelete(session.Id)">Delete</button></td>
                </div>
            </tr>
        }
    </tbody>
</table>

@* Edit Session Dialog *@
@if (editSessionDialog == true) {
    <CreateSessionDialog 
        session="selectedSession" 
        CloseDialog="() => ToggleEditSessionDialog(selectedSession!)" 
        OnSessionCreated="SessionReload" 
        isEdit="true"/>
}


@code {
    public List<ClassSession> sessions = new();
    public bool editSessionDialog = false;
    public ClassSession? selectedSession { get; set; }
    private string query { get; set; } = string.Empty;
    private IEnumerable<ClassSession> queriedSessions =>
        string.IsNullOrWhiteSpace(query)
            ? sessions
            : sessions.Where(session =>
                (session.Course != null && (
                    session.Course.Name.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                    session.Course.Code.Contains(query, StringComparison.OrdinalIgnoreCase)
                )) ||
                (session.Location.Contains(query, StringComparison.OrdinalIgnoreCase)) ||
                (session.Instructor != null && (
                    session.Instructor.FirstName.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                    session.Instructor.LastName.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                    $"{session.Instructor.FirstName} {session.Instructor.LastName}".Contains(query, StringComparison.OrdinalIgnoreCase)
                )) ||
                session.StartDate.ToString().Contains(query, StringComparison.OrdinalIgnoreCase) ||
                session.EndDate.ToString().Contains(query, StringComparison.OrdinalIgnoreCase) ||
                session.StartTime.ToString().Contains(query, StringComparison.OrdinalIgnoreCase) ||
                session.EndTime.ToString().Contains(query, StringComparison.OrdinalIgnoreCase)
            );

    protected override async Task OnInitializedAsync()
    {
        await SessionReload();
    }

    public async Task SessionReload() {
        try
        {
            sessions = await sessionService.GetAllClassSessions();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"An exception occurred while getting all sessions. Ex: {ex}");
        }
    }

    public void ToggleEditSessionDialog(ClassSession sessionChosen) {
        selectedSession = sessionChosen;
        if (editSessionDialog == false) editSessionDialog = true;
        else if (editSessionDialog == true) editSessionDialog = false;
    }

    public async Task HandleDelete(int id) {
        try {
            @* Pop-up alert confirming delete *@
            bool confirmation = await JS.InvokeAsync<bool>
                ("confirm", 
                "Do you want to delete this class session? This cannot be undone. ");

            @* Delete session or exit *@
            if (confirmation) await sessionService.DeleteClassSession(id);
            else return;

            @* Reload page *@
            await SessionReload();
        }
        catch (Exception ex) {
            Console.WriteLine($"Could not complete delete of class session. Ex: {ex}");
        }
    }

    private void UpdateQuery(ChangeEventArgs e)
    {
        if (e == null || e.Value == null)
        {
            query = string.Empty;
            return;
        }

        if (string.IsNullOrWhiteSpace(e.Value.ToString()) == true)
        {
            query = string.Empty;
        }
        else
        {
            query = e.Value.ToString()!;
        }
    }

}