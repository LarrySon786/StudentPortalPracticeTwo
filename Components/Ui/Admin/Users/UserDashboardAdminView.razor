@* List of all tabs to display *@
<div class="tab-nav add-margin-bottom">
    <div>
        <a href="/admin/students" class="btn btn-link">⬅ Return</a>
    </div>
    <button class="btn btn-link @(Tab == TabSelected.Demographics ? "active" : "")" type="button"
            @onclick="() => TabSwitch(TabSelected.Demographics)">Demographics</button>
    <button class="btn btn-link @(Tab == TabSelected.EnrolledPrograms ? "active" : "")" type="button"
            @onclick="() => TabSwitch(TabSelected.EnrolledPrograms)">Enrolled Programs</button>
    <button class="btn btn-link @(Tab == TabSelected.CurrentCourses ? "active" : "")" type="button"
            @onclick="() => TabSwitch(TabSelected.CurrentCourses)">Current Courses</button>
    <button class="btn btn-link @(Tab == TabSelected.DegreeProgress ? "active" : "")" type="button"
            @onclick="() => TabSwitch(TabSelected.DegreeProgress)">Degree Progress</button>
    <button class="btn btn-link @(Tab == TabSelected.Other ? "active" : "")" type="button"
            @onclick="() => TabSwitch(TabSelected.Other)">Other</button>
</div>

