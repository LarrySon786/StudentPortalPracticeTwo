@using System.Runtime.CompilerServices
@using StudentPortalPracticeTwo.Database.Models.Enums;
@using StudentPortalPracticeTwo.Database.Models.Users
@using StudentPortalPracticeTwo.Database.Models.Users.Admin
@using StudentPortalPracticeTwo.Database.Models.Users.Faculty
@using StudentPortalPracticeTwo.Database.Models.Users.Students
@inject StudentPortalPracticeTwo.Components.Services.Users.UserService userService

@* List of all tabs to display *@
<div class="tab-nav add-margin-bottom">
    <div>
        <a href="/admin/students" class="btn btn-link">⬅ Return</a>
    </div>
    <button class="btn btn-link @(Tab == TabSelected.Demographics ? "active" : "")" type="button"
            @onclick="() => TabSwitch(TabSelected.Demographics)">Demographics</button>
    
    
    @if (User is Student) {
        <button class="btn btn-link @(Tab == TabSelected.EnrolledPrograms ? "active" : "")" type="button"
            @onclick="() => TabSwitch(TabSelected.EnrolledPrograms)">Enrolled Programs</button>
        <button class="btn btn-link @(Tab == TabSelected.CurrentCourses ? "active" : "")" type="button"
            @onclick="() => TabSwitch(TabSelected.CurrentCourses)">Current Courses</button>
        <button class="btn btn-link @(Tab == TabSelected.DegreeProgress ? "active" : "")" type="button"
            @onclick="() => TabSwitch(TabSelected.DegreeProgress)">Degree Progress</button>
    }
    else if (User is Faculty) {
        <button class="btn btn-link @(Tab == TabSelected.ClassSessions ? "active" : "")" type="button"
                @onclick="() => TabSwitch(TabSelected.ClassSessions)">Class Sessions</button>
    }
    else if (User is AdminModel) {

    }
        
    <AuthorizeView Roles="Admin">
        <Authorized>
            <button type="button" class="btn @(User.IsDisabled ? "btn-danger" : "btn-primary")" @onclick="DeactivateUser">
                @(User.IsDisabled! 
                ? "Deactivate User"
                : "Reactivate User")
            </button>
        </Authorized>
    </AuthorizeView>
</div>

@* Filters page contents based on selected tab *@
@if (Tab == TabSelected.Demographics) {
    <UserDemographics user="User" />

}
else if (Tab == TabSelected.EnrolledPrograms) {
    @* RENDER *@
}
else if (Tab == TabSelected.CurrentCourses)
{
    @* RENDER *@
}
else if (Tab == TabSelected.DegreeProgress)
{
    @* RENDER *@
}
else if (Tab == TabSelected.Other)
{
    @* RENDER *@
}
@* ADD A SECTION TO DISPLAY CHANGES LOG *@


@code {
    [Parameter] public EditMode Mode { get; set; } = EditMode.View;
    [Parameter] public EventCallback OnSavedChanges { get; set; }
    [Parameter] required public UserModel User { get; set; }
    public TabSelected Tab{ get; set; } = TabSelected.Demographics;

    public enum TabSelected {
        Demographics,
        EnrolledPrograms,
        CurrentCourses,
        DegreeProgress,
        Other,
        ClassSessions
    }


    public void TabSwitch(TabSelected tab) {
        Tab = tab;
    }

    public async Task HandleChanges() {
        await OnSavedChanges.InvokeAsync();
        StateHasChanged();
    }

    public async Task DeactivateUser() {
        await userService.DisableUserToggle(User.Id);
    }

}

<style>
    .tab-nav {
        display: flex;
        justify-content: space-around;
    }

    .bottom-bar {
        position: fixed;
        bottom: 10px;
        right: 10px;
    }

    .page-content {
        margin-bottom: 15px;
        min-height: 80vh;
    }

    .active {
        text-decoration: none;
    }
</style>