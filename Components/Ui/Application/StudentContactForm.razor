@using StudentPortalPracticeTwo.Database.Models.Application

<FormNavigation Model="@Model" Next="@Next" Prev="@Prev" CurrentPage="@CurrentPage" TotalPages="@TotalPages">
    <label class="form-label">Phone</label>
    <InputText class="form-control" @bind-Value="Model.DraftStudentContact!.Phone" />
    <ValidationMessage For="@(() => Model.DraftStudentContact.Phone)" />

    <label class="form-label">Alternative Phone (optional)</label>
    <InputText class="form-control" @bind-Value="Model.DraftStudentContact!.AltPhone" />
    <ValidationMessage For="@(() => Model.DraftStudentContact.AltPhone)" />

    <label class="form-label">Email</label>
    <InputText class="form-control" @bind-Value="Model.Email" disabled />
    <ValidationMessage For="@(() => Model.Email)" />
    <p class="text-muted">Please create a new student application if you wish to change your email address.</p>

</FormNavigation>


@code {
    [Parameter] public required DraftApplicationModel Model { get; set; }
    [Parameter] public EventCallback Next { get; set; }
    [Parameter] public EventCallback Prev { get; set; }
    [Parameter] public int CurrentPage { get; set; }
    [Parameter] public int TotalPages { get; set; }

}