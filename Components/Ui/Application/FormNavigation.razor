@typeparam TModel



<EditForm Model="@Model" OnValidSubmit="HandleSubmit">

    @ChildContent

    @messages

    <div class="container form-actions-bar">
        <button type="button" class="btn btn-primary" @onclick="OnBack">Back</button>
        <button type="submit" class="btn btn-primary">Next</button>
    </div>

</EditForm>






@code {
    [Parameter] public required TModel Model { get; set; }
    [Parameter] public EventCallback Next { get; set; }
    [Parameter] public EventCallback Prev { get; set; }
    [Parameter] public int CurrentPage { get; set; }
    [Parameter] public int TotalPages { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private string messages = "";

    public async Task HandleSubmit() {
        await Next.InvokeAsync();
    }

    public async Task OnBack() {
        await Prev.InvokeAsync();
    }
}

<style>
    .form-actions-bar {
        position: sticky;
        bottom: 0;

        background: white;
        padding: 16px 24px;
        margin-top: 24px;

        display: flex;
        justify-content: flex-end;
        gap: 12px;

        border-top: 1px solid #E0F0EE;
    }
    
</style>

