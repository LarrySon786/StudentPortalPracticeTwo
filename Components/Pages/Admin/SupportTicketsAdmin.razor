@page "/admin/support"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@using StudentPortalPracticeTwo.Database.Models.SupportTicket
@using StudentPortalPracticeTwo.Database.Models.Enums
@using StudentPortalPracticeTwo.Database.Models.Ui
@using StudentPortalPracticeTwo.Components.Ui
@inject StudentPortalPracticeTwo.Components.Services.SupportTicketServices.SupportTicketService supportTicketService
<div class="standard-card">
    <div>
        <BreadCrumbs Crumbs="crumbs" />
        <a href="@crumbs[^2].Link" class="btn btn-link">⬅ Back</a>
    </div>

    @* SEARCH BAR *@
        <div>
            <input class="form-control" placeholder="Search..." type="text" @oninput="UpdateQuery"/>
        </div>

    @* Filter Buttons *@
        <div>
            <button class="btn @(filter == SupportStatus.Any ? "btn-primary" : "btn-secondary")" type="button" @onclick="() => ChangeFilter(SupportStatus.Any)">
                Any
            </button>
            <button class="btn @(filter == SupportStatus.Submitted ? "btn-primary" : "btn-secondary")" type="button" @onclick="() => ChangeFilter(SupportStatus.Submitted) ">
                Pending
            </button>
            <button class="btn @(filter == SupportStatus.Awaiting ? "btn-primary" : "btn-secondary")" type="button" @onclick="() => ChangeFilter(SupportStatus.Awaiting)">
                Awaiting Student Response
            </button>
            <button class="btn @(filter == SupportStatus.Resolved ? "btn-primary" : "btn-secondary")" type="button" @onclick="() => ChangeFilter(SupportStatus.Resolved)">
                Resolved
            </button>
        </div>

    @if (queriedTickets.Count() == 0)
    {
        <p>No Results.</p>
    }
    else {
        @* DISPLAY tickets *@
        <table class="table">
            <thead>
                <tr>
                    <th>Student</th>
                    <th>Ticket Title</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (SupportTicket ticket in queriedTickets)
                {
                    <tr>
                        <td>@ticket.Student.FirstName @ticket.Student.LastName</td>
                        <td>@ticket.Title</td>
                        <td>@ticket.Status</td>
                        <td>
                            <a href="/dashboard/support/ticket/@ticket.Id">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        
    }
</div>

@code {
    public List<SupportTicket> tickets { get; set; } = new();
    public IEnumerable<SupportTicket> filteredTickets => // Filter the results by type selected
        (filter == SupportStatus.Any 
            ? tickets
            : tickets.Where(x => x.Status == filter));
    public IEnumerable<SupportTicket> queriedTickets =>
        (!string.IsNullOrWhiteSpace(query)
            ? filteredTickets.Where(x => x.Title.ToLower().Contains(query) ||
                x.Student.FirstName.ToLower().Contains(query) ||
                x.Student.LastName.ToLower().Contains(query))
            : filteredTickets
        );
    public SupportStatus filter { get; set; } = SupportStatus.Submitted;
    private string query { get; set; } = string.Empty;
    public List<BreadCrumbModel> crumbs { get; set; } = new() // Crumbs passed into component
    {
        new BreadCrumbModel {
            Name= "Admin Dashboard",
            Link="/admin",
        },
        new BreadCrumbModel {
            Name="Support Tickets",
            IsCurrent = true,
        }
    };


    protected override async Task OnInitializedAsync() {
        tickets = await supportTicketService.GetAllTickets();
    }

    private void ChangeFilter(SupportStatus newFilter) {
        filter = newFilter;
    }

    private void UpdateQuery(ChangeEventArgs e) {
        if (e == null || e.Value == null) {
            query = string.Empty;
            return;
        }

        if (string.IsNullOrWhiteSpace(e.Value.ToString()) == true) {
            query = string.Empty;
        }
        else {
            query = e.Value.ToString()!.ToLower();
        }
    }
}