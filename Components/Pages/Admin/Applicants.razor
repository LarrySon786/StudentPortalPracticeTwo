@page "/admin/applicants"
@rendermode InteractiveServer
@using StudentPortalPracticeTwo.Database.Models.Application;
@inject StudentPortalPracticeTwo.Components.Services.Application.FinalApplicationDb studentApplication;
@inject NavigationManager navigationManager;

<h1>New Student Applications</h1>
<a href="/admin" class="btn btn-link">⬅ Return</a>

<div class="standard-card">
    @* Search Filter *@
    <div class="search-bar">
        <input class="form-control" id="searchFilter" placeholder="Search..." @oninput="SearchQuery"/>

        @* Buttons to decide filter for table *@
        <div> 
            <button class="btn @(selectedFilter == Status.All ? "btn-secondary" : "btn-primary")" type="button"
                    @onclick="() => ChangeFilter(Status.All)">All</button>
            <button class="btn @(selectedFilter == Status.Pending ? "btn-secondary" : "btn-primary")" type="button"
                    @onclick="() => ChangeFilter(Status.Pending)">Pending</button>
            <button class="btn @(selectedFilter == Status.Approved ? "btn-secondary" : "btn-primary")" type="button" 
                    @onclick="() => ChangeFilter(Status.Approved)">Approved</button>
            <button class="btn @(selectedFilter == Status.Denied ? "btn-secondary" : "btn-primary")" type="button"
                    @onclick="() => ChangeFilter(Status.Denied)">Denied</button>
        </div>
    </div>

    @* Table to display ALL STUDENT APPLICANTS PENDING *@
    <table class="table">
        <thead>
            <th>Student</th>
            <th>Date of Birth</th>
            <th>Email</th>
            <th>Date Received</th>
        </thead>
        <tbody>
            @if (applicationsReceived == null || applicationsReceived.Count == 0) {
                <p>Loading Pending Applications...</p>
            }
            else {
                @foreach (ApplicationModel application in filteredApplications!) {
                    @* Double click on student to open their details *@
                    <tr @ondblclick="() => ReviewStudent(application.Id)">
                        <td>@application.StudentInfo.FirstName @application.StudentInfo.LastName</td>
                        <td>@application.StudentInfo.DateOfBirth</td>
                        <td>@application.Email</td>
                        <td>INSERT_DATE RECEIVED</td>
                    </tr>
                }
                for (int i = 1; i <= totalPages; i++) {
                    var pages = i;
                    <button class="btn btn-link" type="button" @onclick="() => SetPage(pages)">@pages</button> 
                    @if (totalPages > 10)
                    {
                        <p class="btn"> ... </p>
                        break;
                    }
                }
                @if (totalPages == 0) {<p>No results found.</p>}
            }
        </tbody>
    </table>
</div>



