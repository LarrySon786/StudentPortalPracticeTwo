@code {
    public List<ApplicationModel> applicationsReceived { get; set; } = new();
    public int currPage { get; set; } = 1;
    public int pageSize { get; set; } = 10; // Edit to change size of pages
    public int totalPages { get; set; }
    public string query { get; set; } = String.Empty;
    public Status selectedFilter { get; set; } = Status.Pending; // This can be changed to display approved, pending, or denied applications.
    public IEnumerable<ApplicationModel> filteredResults => //This is the filter logic for approved / denied / pending.
            selectedFilter == Status.All
                ? applicationsReceived!
                    .Where(a => string.IsNullOrWhiteSpace(query) ||
                                        a.StudentInfo.FirstName.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                                        a.StudentInfo.LastName.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                                        a.Email.Contains(query, StringComparison.OrdinalIgnoreCase))
                : applicationsReceived!
                    .Where(a => (a.ApprovedStatus == selectedFilter) &&
                                        (string.IsNullOrWhiteSpace(query) ||
                                        a.StudentInfo.FirstName.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                                        a.StudentInfo.LastName.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                                        a.Email.Contains(query, StringComparison.OrdinalIgnoreCase)));

    public IEnumerable<ApplicationModel> filteredApplications => // This filter handles pagination
            filteredResults
                .Skip((currPage - 1) * pageSize)
                .Take(pageSize);


    protected override async Task OnInitializedAsync() {
        try {
            applicationsReceived = await studentApplication.GetAllApplications();
        }
        catch (Exception ex) {
            Console.WriteLine($"Could not load existing applicants. Ex: {ex}");
        }

        UpdateTotalPages();
    }

    @* Review a student's application ID *@
    public void ReviewStudent(int id) {
        navigationManager.NavigateTo($"/admin/applicants/{id}", forceLoad: true);
        return;
    }

    @* Search query to search for student by name, email, or DOB *@
    public void SearchQuery(ChangeEventArgs e) {
        if (e.Value == null) query = "";
        else query = e!.Value!.ToString()!;
        SetPage(1);
        UpdateTotalPages();
    }

    public void ChangeFilter(Status status) {
        selectedFilter = status;
        SetPage(1);
        UpdateTotalPages();
    }

    public void SetPage(int page) {
        currPage = page;
    }

    private void UpdateTotalPages()
    {
        totalPages = (int)Math.Ceiling(filteredResults.Count() / (double)pageSize);

        if (currPage > totalPages)
            currPage = totalPages;
    }


}


