@page "/admin/admin/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@using StudentPortalPracticeTwo.Components.Ui.Admin.Users
@using StudentPortalPracticeTwo.Database.Models.Users.Admin
@using StudentPortalPracticeTwo.Database.Models.Enums
@inject StudentPortalPracticeTwo.Components.Services.Users.AdminService adminService

@if (admin == null) {
    <p>Loading user information</p>
}
else {
    <div>
        <h1>@admin.FirstName @admin.LastName</h1>
        <UserDashboardAdminView Mode="EditMode.Edit" User="admin" OnSavedChanges="RefreshComponent" />
    </div>
}







@code {
    [Parameter] public int Id { get; set; }
    public AdminModel? admin { get; set; }

    protected override async Task OnInitializedAsync() {
        admin = await adminService.GetAdminById(Id);
        if (admin == null)
        {
            navigationManager.NavigateTo("/admin/faculty");
            return;
        }
    }

    public async Task RefreshComponent()
    {
        await adminService.GetAdminById(Id);
        StateHasChanged();
    }
}