@page "/admin/applicants/{applicationId:int}"
@using StudentPortalPracticeTwo.Components.Ui.Admin.Users.PendingApplicants
@using StudentPortalPracticeTwo.Database.Models.Application;
@using StudentPortalPracticeTwo.Components.Ui.Admin.Users
@inject StudentPortalPracticeTwo.Components.Services.Application.FinalApplicationDb finalApplicationService;
@inject NavigationManager navigationManager;

@if (studentApplication == null) { <p>Loading student details...</p> }
else
{
    <h1>@studentApplication!.StudentInfo.FirstName @studentApplication.StudentInfo.LastName</h1>

    <div class="tab-nav add-margin-bottom">
        <a href="/admin/applicants">⬅ Return</a>
        <button class="btn btn-link @(tab == StudentTab.Demographics ? "active" : "")" type="button" @onclick="() => TabSwitch(StudentTab.Demographics)">Demographics</button>
        <button class="btn btn-link @(tab == StudentTab.Academics ? "active" : "")" type="button" @onclick="() => TabSwitch(StudentTab.Academics)">Academics</button>
        <button class="btn btn-link @(tab == StudentTab.Essays ? "active" : "")" type="button" @onclick="() => TabSwitch(StudentTab.Essays)">Essays</button>
    </div>
    
    <div class="page-content">
        @* Display different tabs depending on selected link *@
        @if (tab == StudentTab.Demographics) 
        {
            <ApplicantDemographics studentApplication="studentApplication"/>
        }
        else if (tab == StudentTab.Academics) 
        {
            <ApplicantProgram studentApplication="studentApplication" />
        }
        else if (tab == StudentTab.Essays)
        {
            <ApplicantEssays studentApplication="studentApplication"/>
        }

    </div>

    <p>@message</p>
    <div class="bottom-bar">
        <button class="btn btn-secondary" type="button" @onclick="() => finalApplicationService.DownloadPdf(applicationId)">
            Download Application PDF
        </button>
        @if (studentApplication.ApprovedStatus == Status.Approved) {
            <button class="btn btn-secondary" type="button">
                Reset Password
            </button>
            <button class="btn btn-danger" type="button">
                Disable Student Account
            </button>
        }
        @if (studentApplication.ApprovedStatus == Status.Pending) {
            <button class="btn btn-danger" type="button" disabled="@approvalLoading" @onclick="() => Decline()">
                Decline Application
            </button>
            <button class="btn btn-primary" type="button" disabled="@approvalLoading" @onclick="() => Approve()">
                Approve Application
            </button>
        }
        @if (studentApplication.ApprovedStatus == Status.Denied) {
            <button class="btn btn-primary" type="button" disabled="@approvalLoading" @onclick="() => Pending()">
                Mark as Pending Application
            </button>
        }
    </div>
}

@code {
    [Parameter] public int applicationId { get; set; }
    public ApplicationModel? studentApplication { get; set; }
    public StudentTab tab { get; set; }
    public string message { get; set; } = "";

    public bool approvalLoading { get; set; } = false;

    public enum StudentTab {
        Demographics,
        Academics,
        Essays,
        Other
    } 

    protected override async Task OnInitializedAsync() {
        try {
            studentApplication = await finalApplicationService.GetById(applicationId);
        }
        catch (Exception ex) {
            Console.WriteLine($"Could not load the student application. Ex: {ex}");
        }
        if (studentApplication == null) {
            navigationManager.NavigateTo("/admin/applicants", forceLoad: true);
            return;
        }
    }

    public void TabSwitch(StudentTab changed) {
        tab = changed;
    }

    public async Task Approve() {
        @* This function disables the approve button and begins creating a student account *@
        try {
            approvalLoading = true;
            await finalApplicationService.ApproveApplication(applicationId);
            navigationManager.NavigateTo("/admin/applicants");
            return;
        }
        catch (Exception ex) {
            Console.WriteLine($"Could not create student account. Ex: {ex}");
            message = $"{ex.Message}";
        }
        finally {
            approvalLoading = false; 
        }
    }

    public async Task Decline()
    {
        @* This function disables the approve button and begins declining a student account *@
        try
        {
            approvalLoading = true;
            await finalApplicationService.DeclineApplication(applicationId);
            navigationManager.NavigateTo("/admin/applicants");
            return;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Could not create student account. Ex: {ex}");
        }
        finally
        {
            approvalLoading = false;
        }
    }

    public async Task Pending() {
        @* In the event that the admission team makes a mistake and wants to approve a denied student *@
        @* They can move them to a pending status once again. *@
        try
        {
            approvalLoading = true;
            await finalApplicationService.PendingApplication(applicationId);
            navigationManager.NavigateTo("/admin/applicants");
            return;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Could not create student account. Ex: {ex}");
        }
        finally
        {
            approvalLoading = false;
        }
    }
}



<style>
    .tab-nav {
        display:flex;
        justify-content: space-around;
    }

    .bottom-bar {
        position: fixed;
        bottom: 10px;
        right: 10px;
    }

    .page-content {
        margin-bottom:15px;
        min-height: 80vh;
    }
    .active {
        text-decoration: none;
    }
</style>