@page "/"
@layout ApplicationLayout
@rendermode InteractiveServer
@using StudentPortalPracticeTwo.Components.Ui
<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.

<a class="btn btn-primary" href="/preapply">Student Application</a>
<a class="btn btn-primary" href="/login">Login</a>
<a class="btn btn-primary" href="/dashboard">Student Dashboard</a>
<a class="btn btn-primary" href="/faculty">Faculty</a>
<a class="btn btn-primary" href="/admin">Admin</a>
<a class="btn btn-primary" href="/catalog">School Degree Catalog</a>



@* COLOR PALLETE and CSS planning BELOW *@
<div class="mt-4">
    <div class="standard-card-container">
        <div class="standard-card">
            <h1>Color Pallete</h1>
            <p>Example Text for this website</p>
        </div>
        <div class="standard-card">
            
        </div>
    </div>
    
    


    <div>
        <button class="btn btn-link">Link</button>
        <button class="btn btn-primary">Primary</button>
        <button class="btn btn-secondary">Secondary</button>
        <button class="btn btn-danger">Danger</button>
    </div>

    <div class="info">
        <p>Info</p>
    </div>
    <div class="alert">
        <p>Alert</p>
    </div>
    <div class="success">
        <p>Success</p>
    </div>

    <button class="btn btn-secondary" @onclick="OpenDialog">Open Dialog</button>

    @if(Dialog) {
        <HomeTestDialog OnClose="CloseDialog" />
    }

</div>

@code {
    private bool Dialog { get; set; } = false;

    private void OpenDialog() {
        Dialog = true;
    }

    private void CloseDialog() {
        Dialog = false;
    }
}



