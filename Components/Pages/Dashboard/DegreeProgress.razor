@page "/dashboard/degree-progress"
@attribute [Authorize]
@rendermode InteractiveServer
@using StudentPortalPracticeTwo.Database.Models.Students
@using StudentPortalPracticeTwo.Database.Models.Degrees


@* This page is to view all Degree Progress *@
@if (user == null || user.MyProgram == null) {
    <p>No Program found. Please sign-up for an academic program to monitor degree progress</p>
}
else {
    <div>
        @* My Program Details *@
        <div>
            <h1>@user.MyProgram.MyDegree!.Name | @user.FirstName @user.LastName</h1>
            <p><span style="font-weight:700;">Start Date:</span> [Insert_start_date]</p>

            @* Percentage Complete *@
            <p><span style="font-weight:700;">Degree Completion:</span> 
                @user.MyProgram.PercentageComplete.ToString("F1")%
            </p>
            <p><span style="font-weight:700;">Expected Graduation:</span> [Insert_Calculated_Graduation]</p>
            <p class="text-muted" style="font-size:smaller;">
                *Expected Graduation Date is based on a full-time 15 credit work load each semester.
            </p>
        </div>

        @* My Program Tools *@
        <div>
            @* Link to Recommended course path *@
            <a href="" class="btn btn-link">My Recommended Path</a>
            @* View My Initial School Application *@
            <a>My CSU Application</a>
        </div>

        @* My Completed Classes *@
        <div>
            <table>
                <thead>
                    <tr>
                        <th>Course Code</th>
                        <th>Course Name</th>
                        <th>Credits</th>
                        <th>Date Completed</th>
                        <th>GPA</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(Course course in user.MyProgram.CompletedCourses){
                        <tr>
                            <td>@course.Code</td>
                            <td>@course.Name</td>
                            <td>@course.Credits</td>
                            <td>[INSERT_DATE_COMPLETED]</td>
                            <td>[INSERT_STUDENT_GPA]</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Incomplete Courses *@
        <div>
            <table>
                <thead>
                    <tr>
                        <th>Course Code</th>
                        <th>Course Name</th>
                        <th>Credits</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (Course course in user.MyProgram.MyDegree.Courses.Except(user.MyProgram.CompletedCourses))
                    {
                        <tr>
                            <td>@course.Code</td>
                            <td>@course.Name</td>
                            <td>@course.Credits</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Button to begin Registering courses *@
        <button class="btn btn-primary" type="button" @onclick="ToggleBeginRegisteration">Register Courses</button>

        @if (IsRegistering) {
            @* REGISTER NEW CLASSES TABLE *@
            <div>
                @*  *@
                <div>

                </div>

                @* Selected Courses *@
                <div>

                </div>
                <button class="btn btn-primary" type="button" @onclikc="RegisterCourses">Register</button>
            </div>
        }


    </div>
}

@code {
    public UserModel? user { get; set; }
    public bool IsRegistering { get; set; } = false;

    protected override async Task OnInitializedAsync() {
        try {
            user = await authService.GetCurrentUserAsync();
            if (user == null) navigationManager.NavigateTo("/login");
        }
        catch (Exception ex) {
            Console.WriteLine(ex);
        }
    }
    public void ToggleBeginRegisteration() { // Toggles the registeration table
        IsRegistering = !IsRegistering;
    }

    public void RegisterCourses() { // This will finalize and save a student's selected courses they want to register.

    }

}
