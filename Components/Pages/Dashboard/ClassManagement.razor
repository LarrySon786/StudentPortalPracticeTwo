@* This page is where students Register class for next term. View existing classes. And drop classes *@
@page "/dashboard/class-management"
@attribute [Authorize]
@rendermode InteractiveServer
@using StudentPortalPracticeTwo.Database.Models.Users
@using StudentPortalPracticeTwo.Database.Models.Users.Students
@inject StudentPortalPracticeTwo.Components.Services.Users.Students.StudentService studentService


@* Existing Classes *@
<div>

</div>

@* Upcoming Classes *@
<div>

</div>



@code {
    public UserModel? user { get; set; }
    public Student? student { get; set; }

    protected override async Task OnInitializedAsync()
    {
        user = await authService.GetCurrentUserAsync();
        if (user != null) student = await studentService.GetStudentById(user.Id);
        else navigationManager.NavigateTo("/login", forceLoad: true);
        
    }
}









