@page "/faculty/accept-invite"
@rendermode InteractiveServer
@using StudentPortalPracticeTwo.Database.Models.Users.Faculty
@using StudentPortalPracticeTwo.Database.Models.Users
@using StudentPortalPracticeTwo.Database.Models.DTOs
@using Microsoft.AspNetCore.Identity
@using System.ComponentModel.DataAnnotations
@inject UserManager<ApplicationUser> userManager
@inject StudentPortalPracticeTwo.Components.Services.Users.Instructors.FacultyService facultyService 

<div class="standard-card">
    <EditForm Model="newFaculty" OnValidSubmit="HandleSubmit" FormName="CreateFacultyForm">
        <DataAnnotationsValidator />

        <label class="form-label">First Name</label>
        <InputText class="form-control" @bind-Value="newFaculty!.FirstName" />
        <ValidationMessage For="@(() => newFaculty.FirstName)" />

        <label class="form-label">Middle Name (optional)</label>
        <InputText class="form-control" @bind-Value="newFaculty.MiddleName" />
        <ValidationMessage For="@(() => newFaculty.MiddleName)" />

        <label class="form-label">Last Name</label>
        <InputText class="form-control" @bind-Value="newFaculty.LastName" />
        <ValidationMessage For="@(() => newFaculty.LastName)" />

        <label class="form-label">Date of Birth</label>
        <InputDate class="form-control" @bind-Value="newFaculty.DateOfBirth" />
        <ValidationMessage For="@(() => newFaculty.DateOfBirth)" />

        <label class="form-label">Email</label>
        <InputText class="form-control" type="email" @bind-Value="newFaculty.Email" />
        <ValidationMessage For="@(() => newFaculty.Email)" />

        <label class="form-label">Phone Number</label>
        <InputText class="form-control" type="tel" @bind-Value="newFaculty.ContactDetails.Phone" />
        <ValidationMessage For="@(() => newFaculty.ContactDetails.Phone)" />

        @* EMERGENCY CONTACTS *@
        @foreach (var contact in newFaculty.EmergencyContact) {
            <label class="form-label">Emegency Contact Name</label>
            <InputText class="form-control" @bind-Value="contact.ContactName" />
            <ValidationMessage For="@(() => contact.ContactName)" />

            <label class="form-label">Emegency Contact Relationship</label>
            <InputText class="form-control" @bind-Value="contact.Relationship" />
            <ValidationMessage For="@(() => contact.Relationship)" />

            <label class="form-label">Emergency Contact Phone Number</label>
            <InputText class="form-control" type="tel" @bind-Value="contact.Phone" />
            <ValidationMessage For="@(() => contact.Phone)" />
        }

        @* ACCOUNT PASSWORD *@
        <label class="form-label">New Password</label>
        <InputText class="form-control" type="password" @bind-Value="password" />
        <ValidationMessage For="@(() => password)" />

        <label class="form-label">Confirm Password</label>
        <InputText class="form-control" type="password" @bind-Value="confirmPassword" />
        <ValidationMessage For="@(() => confirmPassword)" />

        <button type="button" class="btn btn-secondary">Close</button>
        <button type="submit" class="btn btn-primary">Create Faculty</button>
    </EditForm>
</div>


@code {
    [SupplyParameterFromQuery] public required string UserId { get; set; } // Registration Id so the student can register and account
    [SupplyParameterFromQuery] public required string Token { get; set; } //Validation Token to reset / create password

    public JsonFaculty? newFaculty { get; set; }

    [Required (ErrorMessage = "Password is required")] 
    [StringLength(100, MinimumLength = 6, ErrorMessage = "Password must be at least 6 characters long.")]
    [DataType(DataType.Password)]
    public string password { get; set; } = string.Empty;

    [Required(ErrorMessage = "Please confirm your password")] 
    [Compare("password", ErrorMessage = "Password and confirmation do not match.")]
    public string confirmPassword { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync() {
        JsonUserEmergencyContact contact = new();

        newFaculty = new()
        {
            EmergencyContact = new() {
                contact
            }
        };
    }

    public async Task HandleSubmit() {  
        try {
            // Create faculty member's user Identity
            var identity = new ApplicationUser()
            {
                UserName = newFaculty!.Email,
                Email = newFaculty.Email,
            };

            @* CREATE Faculty member's identity *@
            var result = await userManager.CreateAsync(identity, password);
            if (!result.Succeeded) throw new Exception("Could not create Instructor's user Identity.");

            @* Create faculty member's data *@
            List<UserEmergencyContactModel> emergencyContacts = new(); // Prepare emergency contacts
            foreach (var contact in newFaculty.EmergencyContact)
            {
                var newContact = new UserEmergencyContactModel()
            {
                ContactName = contact.ContactName,
                Relationship = contact.Relationship,
                Phone = contact.Phone,
            };
                emergencyContacts.Add(newContact);
            }

            var entity = new Faculty() // Create each faculty member
            {
                FirstName = newFaculty.FirstName,
                MiddleName = newFaculty.MiddleName,
                LastName = newFaculty.LastName,
                Email = newFaculty.Email,
                DateOfBirth = newFaculty.DateOfBirth,
                ContactDetails = new()
                {
                    Phone = newFaculty.ContactDetails.Phone
                },
                EmergencyContact = emergencyContacts,
                IdentityUserId = identity.Id
            };
            await facultyService.CreateFaculty(entity); // Add and Save

            navigationManager.NavigateTo("/login", forceLoad: true);
        }
        catch (Exception ex) {
            Console.WriteLine($"Could not create new faculy member. Ex: {ex}");
        }
    }

}
