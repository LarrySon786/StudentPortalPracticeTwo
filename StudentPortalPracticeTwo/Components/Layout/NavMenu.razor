@using StudentPortalPracticeTwo.Database.Models.Users
@inject NavigationManager navigationManager

<div class="left-tab @(NavOpen ? "" : "closed")">
    <nav>

        @* User Profile *@
        @if (user != null)
        {
            <a href="/my-account">
                <div class="account-container">
                    <div class="profile-pic">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512">
                            <path d="M0 64C0 28.7 28.7 0 64 0L320 0c35.3 0 
                            64 28.7 64 64l0 384c0 35.3-28.7 64-64 64L64 512c-35.3 
                            0-64-28.7-64-64L0 64zM80 368c0 8.8 7.2 16 16 16l192 0c8.8 
                            0 16-7.2 16-16 0-44.2-35.8-80-80-80l-64 0c-44.2 0-80 35.8-80 80zM192 
                            248a56 56 0 1 0 0-112 56 56 0 1 0 0 112z" />
                        </svg>
                    </div>

                    <div class="account-name-container">
                        <h2 class="account-name">Welcome</h2>
                        <h2 class="account-name">@user.FirstName @user.LastName</h2>
                    </div>
                </div>
            </a>
        }

        @* STUDENTS *@
        <AuthorizeView Roles="Student">
            <Authorized>
                <div class="nav-group">

                    <div class="nav-item">
                        <NavLink href="/dashboard" Match="NavLinkMatch.All">
                            <i class="fa-solid fa-house"></i>
                            <span>Student Dashboard</span>
                        </NavLink>
                    </div>

                    <div class="nav-item">
                        <NavLink href="/dashboard/my-classes" Match="NavLinkMatch.Prefix">
                            <i class="fa-solid fa-book-open"></i>
                            <span>My Classes</span>
                        </NavLink>
                    </div>

                    <div class="nav-item">
                        <NavLink href="/dashboard/degree-progress" Match="NavLinkMatch.Prefix">
                            <i class="fa-solid fa-chart-line"></i>
                            <span>Degree Progress</span>
                        </NavLink>
                    </div>

                    <div class="nav-item">
                        <NavLink href="/dashboard/support" Match="NavLinkMatch.Prefix">
                            <i class="fa-solid fa-headset"></i>
                            <span>Student Support</span>
                        </NavLink>
                    </div>

                </div>
            </Authorized>
        </AuthorizeView>


        @* FACULTY *@
        <AuthorizeView Roles="Faculty">
            <Authorized>
                <div class="nav-group">

                    <div class="nav-item">
                        <NavLink href="/faculty" Match="NavLinkMatch.All">
                            <i class="fa-solid fa-house"></i>
                            <span>Faculty Dashboard</span>
                        </NavLink>
                    </div>

                    <div class="nav-item">
                        <NavLink href="/faculty/classes" Match="NavLinkMatch.Prefix">
                            <i class="fa-solid fa-chalkboard"></i>
                            <span>My Class Sessions</span>
                        </NavLink>
                    </div>

                </div>
            </Authorized>
        </AuthorizeView>


        @* ADMINS *@
        <AuthorizeView Roles="Admin">
            <Authorized>
                <div class="nav-group">

                    <div class="nav-item">
                        <NavLink href="/admin" Match="NavLinkMatch.All">
                            <i class="fa-solid fa-house nav-icon"></i>
                            <span>Admin Dashboard</span>
                        </NavLink>
                    </div>

                    <div class="nav-item">
                        <NavLink href="/admin/students" Match="NavLinkMatch.Prefix">
                            <i class="fa-solid fa-user-group"></i>
                            <span>CSU Students</span>
                        </NavLink>
                    </div>

                    <div class="nav-item">
                        <NavLink href="/admin/applicants" Match="NavLinkMatch.Prefix">
                            <i class="fa-solid fa-file-signature"></i>
                            <span>CSU Applicants</span>
                        </NavLink>
                    </div>

                    <div class="nav-item">
                        <NavLink href="/admin/faculty" Match="NavLinkMatch.Prefix">
                            <i class="fa-solid fa-chalkboard-user"></i>
                            <span>CSU Faculty</span>
                        </NavLink>
                    </div>

                    <div class="nav-item">
                        <NavLink href="/degree-listings" Match="NavLinkMatch.Prefix">
                            <i class="fa-solid fa-graduation-cap"></i>
                            <span>Degree Listings</span>
                        </NavLink>
                    </div>

                    <div class="nav-item">
                        <NavLink href="/admin/support" Match="NavLinkMatch.Prefix">
                            <i class="fa-solid fa-ticket"></i>
                            <span>Support Tickets</span>
                        </NavLink>
                    </div>

                </div>
            </Authorized>
        </AuthorizeView>

    </nav>


    @* Logout *@
    <div class="form-logout-section">
        <form method="post" action="/account/logout">
            <button type="submit" class="btn btn-link">
                Logout
            </button>
        </form>
    </div>


    @* Button to open and close navigation *@
    <button class="btn nav-open-close-button" @onclick="HandleToggle">
        @(NavOpen ? "⮜" : "⮞")
    </button>

</div>


@code {
    [Parameter] public bool NavOpen { get; set; } = true;
    [Parameter] public EventCallback ToggleNav { get; set; }

    public UserModel? user { get; set; }

    protected override async Task OnInitializedAsync()
    {
        user = await authService.GetCurrentUserAsync();

        if (user == null)
            navigationManager.NavigateTo("/login");
    }

    public async Task HandleToggle()
    {
        await ToggleNav.InvokeAsync();
    }
}