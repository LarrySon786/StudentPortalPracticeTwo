
@page "/"
@using StudentPortalPracticeTwo.Components.Ui
@layout ApplicationLayout
@rendermode InteractiveServer

<PageTitle>Home | CSU University Portal</PageTitle>

<div class="home-page">

    @* Section One | Portal Tools *@
    <section class="portal-tools-section" aria-label="University portal tools">
        <div class="portal-tools-container">

            <PortalTools Title="Student Application"
                         Description="Take the first step toward your future at Cascade State University."
                         ActionButton="Apply Now" ImageRef="images/apply.jpg" ImageAlt="College application paperwork on a desk"
                         HrefLink="/preapply" />

            <PortalTools Title="Program Catalog"
                         Description="Explore academic programs and find the degree that fits your goals."
                         ImageRef="images/catalog.jpg" ImageAlt="Academic materials and university books"
                         ActionButton="Explore Programs" HrefLink="/catalog" />

            <PortalTools Title="Student Login"
                         Description="Access your student portal, manage your information, and continue your journey."
                         ImageRef="images/login.jpg" ImageAlt="Laptop and notebook on a university study desk"
                         ActionButton="Sign In" HrefLink="/login" />

        </div>
    </section>

    @* Section Two | About the Author *@
    <section class="about-author">
        <div class="about-author-content">
            <span class="section-eyebrow">BEHIND THE PROJECT</span>
            <h2>About the Author</h2>
            <div class="author-divider"></div>
            <h3>Brandon Richards</h3>
            <p>
                This university portal was created as a software development
                project to demonstrate web application design, data management,
                and modern .NET development.
            </p>
        </div>
    </section>

    @* Section Three | Footer *@
    <footer class="home-footer">
        <div class="footer-main">
            <div class="footer-brand">
                <a href="/" class="footer-logo">CSU</a>
                <p>Cascade State University</p>
                <a href="https://github.com/LarrySon786/StudentPortalPracticeTwo" target="_blank"
                   rel="noopener noreferrer" class="footer-github">
                    View the project on GitHub ↗
                </a>
            </div>

            <div class="quick-link-container">
                <h3>Quick Links</h3>
                <nav class="quick-links" aria-label="Quick links">
                    <a href="/dashboard">Student Portal</a>
                    <a href="/faculty">Faculty Portal</a>
                    <a href="/admin">Admin Portal</a>
                    <a href="/dev">Developer Tools</a>
                </nav>
            </div>
        </div>
    </footer>

</div>

