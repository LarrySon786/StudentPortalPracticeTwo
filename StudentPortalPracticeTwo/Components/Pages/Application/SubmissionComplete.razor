@page "/submission-complete"
@layout ApplicationLayout
@using Database.Models.Application
@using StudentPortalPracticeTwo.Components.Services.Application
@using StudentPortalPracticeTwo.Components.Services.PdfServices
@inject FinalApplicationDb data
@inject NavigationManager NavigationManager
@inject PdfService pdfService
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="m-4 center-content">
    <div class="standard-card thank-you">
        <h1>Application Received</h1>

        @if (Final == null) {
            @* LOADING UNTIL DATABASE FETCH COMPELTES *@
            <p>Application Loading...</p>
        }
        else {
            @* USER EXPECTATIONS AND INSTRUCTIONS *@
            <p>
                You application has been received and will be reviewed by our enrollment department. You can reach them here at:
                <span class="weighted">enroll@csu.edu</span>. 
            </p>
            <p>
                Please allow 3 weeks for your application to be reviewed. You will receive an email with the status
                of your enrollment at <span class="weighted">@Final.Email</span>
            </p>

            @* ACTION ITEMS *@
            <div>
                <button type="button" class="btn btn-primary submit-button mt-2" @onclick="DownloadPdf">Download a copy of your Application</button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public int FinalApplicationId { get; set; }
    public ApplicationModel? Final { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var applicationEmailClaim = user.FindFirst("ApplicationEmail")?.Value;

        if (applicationEmailClaim == null)
        {
            navigationManager.NavigateTo("/");
        }

        Final = await data.GetByEmail(applicationEmailClaim!);
        if (Final == null) {
            NavigationManager.NavigateTo("/");
        }
    }

    private async Task DownloadPdf()
    {
        byte[]? pdf = pdfService.GenerateApplicationPdf();
        string base64 = Convert.ToBase64String(pdf);

        @* Uses javascript code to allow downloading PDF *@
        await JS.InvokeVoidAsync( "downloadPdf", "CSU-Application.pdf", base64);
    }
}

<style>
    .weighted {
        font-weight: 700;
    }
    .center-content {
        display:flex;
        justify-content: center;
    }
    .thank-you {
        max-width: 650px;
    }
    .submit-button {
        width:100%;
    }
</style>

