@page "/admin/faculty/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@using StudentPortalPracticeTwo.Components.Ui.Admin.Users
@using StudentPortalPracticeTwo.Database.Models.Users.Faculty
@using StudentPortalPracticeTwo.Database.Models.Enums
@using StudentPortalPracticeTwo.Database.Models.Ui
@using StudentPortalPracticeTwo.Components.Ui
@inject StudentPortalPracticeTwo.Components.Services.Users.Instructors.FacultyService facultyService

<div>
    <BreadCrumbs Crumbs="crumbs" />
</div>

@if (faculty == null) {
    <p>Loading user information</p>
}
else {
    <div>
        <h1>@faculty.FirstName @faculty.LastName</h1>
        <UserDashboardAdminView Mode="EditMode.Edit" User="faculty" OnSavedChanges="RefreshComponent"/>
    </div>
}







@code {
    [Parameter] public int Id { get; set; }
    public Faculty? faculty { get; set; }
    public List<BreadCrumbModel> crumbs { get; set; } = new() // Crumbs passed into component
    {
        new BreadCrumbModel {
            Name= "Admin Dashboard",
            Link="/admin",
        },
        new BreadCrumbModel {
            Name="Faculty",
            Link="/admin/faculty"
        },
        new BreadCrumbModel {
            Name = "Profile",
            IsCurrent = true,
        }
    };

    protected override async Task OnInitializedAsync() {
        faculty = await facultyService.GetById(Id);
        if (faculty == null) {
            navigationManager.NavigateTo("/admin/faculty");
            return;
        }
    }

    public async Task RefreshComponent()
    {
        await facultyService.GetById(Id);
        StateHasChanged();
    }
}