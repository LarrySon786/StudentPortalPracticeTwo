@page "/admin/students/{studentId:int}"
@attribute [Authorize(Roles = "Admin")]
@using StudentPortalPracticeTwo.Database.Models.Users.Students
@using StudentPortalPracticeTwo.Database.Models.Enums
@using StudentPortalPracticeTwo.Components.Ui.Admin.Users;
@using StudentPortalPracticeTwo.Database.Models.Ui
@using StudentPortalPracticeTwo.Components.Ui

@inject StudentPortalPracticeTwo.Components.Services.Users.Students.StudentService studentService;
@inject NavigationManager navigationManager


<div>
    <BreadCrumbs Crumbs="crumbs"/>
</div>

@if (student == null) {
    <p>Loading student details...</p>
}
else {
    <h1>@student!.FirstName @student.LastName | Student</h1>

    <div class="path-finding">
        <a href="" class="btn btn-link"></a>
    </div>

    <UserDashboardAdminView Mode="EditMode.Edit" User="student" OnSavedChanges="RefreshComponent" />



}

@code {
    [Parameter] public int studentId { get; set; } // received on page initialize
    public Student? student { get; set; }
    public List<BreadCrumbModel> crumbs { get; set; } = new() // Crumbs passed into component
    {
        new BreadCrumbModel {
            Name= "Admin Dashboard",
            Link="/admin",
        },
        new BreadCrumbModel {
            Name="Students",
            Link="/admin/students"
        },
        new BreadCrumbModel {
            Name = "Student Profile",
            IsCurrent = true,
        }
    };

    protected async override Task OnInitializedAsync() {
        await GetStudent();
    }

    public async Task GetStudent() {
        student = await studentService.GetStudentById(studentId);
        if (student == null) navigationManager.NavigateTo("/admin/students");
    }

    public async Task RefreshComponent() {
        await GetStudent();
        StateHasChanged();
    }
}