@page "/dashboard/degree-progress"
@attribute [Authorize(Roles = "Student")]
@rendermode InteractiveServer
@using StudentPortalPracticeTwo.Components.Ui.StudentPortal
@using StudentPortalPracticeTwo.Database.Models.Users
@using StudentPortalPracticeTwo.Database.Models.Users.Students
@using StudentPortalPracticeTwo.Database.Models.Degrees
@using StudentPortalPracticeTwo.Components.Services.Extensions
@using StudentPortalPracticeTwo.Database.Models.Ui
@using StudentPortalPracticeTwo.Components.Ui
@inject StudentPortalPracticeTwo.Components.Services.Users.Students.RegisterCourses registerCourses
@inject StudentPortalPracticeTwo.Components.Services.Users.Students.StudentService studentService
@inject StudentPortalPracticeTwo.Components.Services.Admin.CourseService courseService

@* This page is to view all Degree Progress *@

<div>
    <BreadCrumbs Crumbs="crumbs"/>
</div>


@if (user == null || user.MyProgram == null) {
    <p>No Program found. Please sign-up for an academic program to monitor degree progress</p>
}
else {
    <div>
        <h1>@user.MyProgram.MyDegree!.Name</h1>
        <h2>@user.FirstName @user.LastName</h2>

        @* My Program Tools *@
        <div class="action-links">
            @* Link to Recommended course path *@
            <a href="/catalog/@user.MyProgram.DegreeId" class="btn btn-primary">My Recommended Path</a>
            @* View My Initial School Application *@
            <button class="btn btn-primary">My CSU Application</button>
        </div>

        @* My Program Details *@
        <div class="standard-card current-course-container mt-4 mb-4">
            @* Current Courses *@
            <h3 class="current-course-header">Current Courses</h3>
            <div>
                <table class="table default-table">
                    <thead>
                        <tr>
                            <th>Course Code</th>
                            <th>Course Name</th>
                            <th>Credits</th>
                            <th></th>
                        </tr>
                        
                    </thead>
                    <tbody>
                        @if (user.MyProgram.CurrentSessions.Count() == 0)
                        {
                            <tr>
                                <td colspan="100%">No active courses</td>
                            </tr>
                        }
                        @foreach (ClassSession session in user.MyProgram.CurrentSessions)
                        {
                            <tr>
                                <td>@session.Course.Code</td>
                                <td>@session.Course.Name</td>
                                <td>@session.Course.Credits</td>
                                <td>
                                    <a class="btn btn-link" href="/" type="button">See My Class</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="progress-summary-container">
                <p class="progress-summary-header">Degree Progress</p>
                

                @* Percentage Complete *@
                <p><span style="font-weight:700;">Degree Completion:</span> 
                    @user.MyProgram.PercentageComplete.ToString("F1")%
                </p>
                <p><span style="font-weight:700;">Current GPA: </span>
                    @if (user.MyProgram.CompletedCourses.Count() > 0) {
                        @(CalculateGPAHelper.CalculateAverageGPA(user.MyProgram.CompletedCourses.Select(x => x.GPA).ToList()).ToString("F2"));
                    }
                    else {
                        <span>--</span>
                    }
                </p>
                <p><span style="font-weight:700;">Start Date:</span> [insert_date]</p>
                <p><span style="font-weight:700;">Expected Graduation:</span> @(GraduationDateHelper.PredictGraduationDate(user.MyProgram, user.MyProgram.MyDegree))</p>
                <p class="text-muted" style="font-size:smaller;">
                    *Expected Graduation Date is based on a full-time 15 credit work load each semester.
                </p>
            </div>
        </div>

        

        @* Registered Classes *@
        <div class="standard-card mt-4 mb-4">
            <h3>Registered Courses</h3>
            <table class="table default-table">
                <thead>
                    <tr>
                        <th>Course Code</th>
                        <th>Course Name</th>
                        <th>Credits</th>
                        <th>View Session</th>
                    </tr>
                </thead>
                <tbody>
                    @if (user.MyProgram.RegisteredSessions.Count() == 0)
                    {
                        <tr>
                            <td colspan="100%">No registered courses</td>
                        </tr>
                    }
                    @foreach (ClassSession session in user.MyProgram.RegisteredSessions)
                    {
                        <tr>
                            <td>@session.Course.Code</td>
                            <td>@session.Course.Name</td>
                            <td>@session.Course.Credits</td>
                            <td>
                                <button class="btn btn-link" type="button">View</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @* Button to begin Registering courses *@
            <button class="btn btn-primary register-button mt-2" type="button" @onclick="ToggleBeginRegisteration">@(!IsRegistering ? "Register Courses" : "Cancel Registration")</button>
        </div>

        
        
        <div class="standard-card incomplete-complete-container mt-4 mb-4">
            @* Incomplete Courses *@
            <div>
                <h3>Incompleted Courses</h3>
                <table class="table default-table smaller-rows-table">
                    <thead>
                        <tr>
                            <th>Course Code</th>
                            <th>Course Name</th>
                            <th>Credits</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (Course course in user.MyProgram.MyDegree.Courses
                            .Where(course => !user.MyProgram.CompletedCourses
                            .Any(completed => completed.Course == course)))
                        {
                            <tr>
                                <td>@course.Code</td>
                                <td>@course.Name</td>
                                <td>@course.Credits</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* My Completed Classes *@
            <div>
                <h3>Completed Courses</h3>
                    <table class="table default-table smaller-rows-table">
                    <thead>
                        <tr>
                            <th>Course Code</th>
                            <th>Course Name</th>
                            <th>Credits</th>
                            <th>Date Completed</th>
                            <th>GPA</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (user.MyProgram.CompletedCourses.Count() == 0)
                        {
                            <tr>
                                <td colspan="100%">No completed courses</td>
                            </tr>
                            }
                        @foreach(CompletedCourse course in user.MyProgram.CompletedCourses){
                            <tr>
                                <td>@course.Course.Code</td>
                                <td>@course.Course.Name</td>
                                <td>@course.Course.Credits</td>
                                <td>@course.DateCompleted</td>
                                <td>@course.GPA.ToString("F2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        

        @if (IsRegistering) {
            @* REGISTER NEW CLASSES TABLE *@
            <Dialog OnClose="ToggleBeginRegisteration">
                <RegisterCoursesDialog 
                    User="user" 
                    AllCourses="allCourses" 
                    CurrentRegisteredSessions="sessions"
                    RegisterCourses="RegisterCourses"
                />
            </Dialog>
        }
        
    </div>
}

@code {
    public UserModel? auth { get; set; }
    public Student? user { get; set; }
    public IEnumerable<Course>? allCourses { get; set; }

    public List<ClassSession> sessions { get; set; } = new();
    public bool IsRegistering { get; set; } = false;
    public List<BreadCrumbModel> crumbs { get; set; } = new() // Crumbs passed into component
    {
        new BreadCrumbModel {
            Name= "Student Dashboard",
            Link="/dashboard",
        },
        new BreadCrumbModel {
            Name="My Degree Progress",
            IsCurrent = true,
        }
    };

    protected override async Task OnInitializedAsync() {
        try {
            auth = await authService.GetCurrentUserAsync(); // Get logged in User Details
            if (auth == null)
            {
                navigationManager.NavigateTo("/login");
                return;
            }

            user = await studentService.GetStudentById(auth!.Id); // Get Student Details
            if (user == null) {
                navigationManager.NavigateTo("/login", forceLoad: true);
                return;
            }

            allCourses = await courseService.GetAllCourses(); // Load all courses for registeration
            sessions = user!.MyProgram.RegisteredSessions ?? []; // Set student's current session plans
        }
        catch (Exception ex) {
            Console.WriteLine(ex);
        }
    }

    public void ToggleBeginRegisteration() { // Toggles the registeration table
        IsRegistering = !IsRegistering;
    }

    public async Task RegisterCourses() { // This will finalize and save a student's selected courses they want to register.
        try
        {
            await registerCourses.RegisterNewCourses(user!, sessions);
            sessions = [];
            IsRegistering = false;
            await ReloadRegisteredSessions();
        }
        catch (Exception ex) {
            Console.WriteLine($"Could not register classes. {ex}");
        }
    }

    public async Task ReloadRegisteredSessions()
    {
        user = await studentService.GetStudentById(auth!.Id); // Get Student Details
        if (user == null)
        {
            navigationManager.NavigateTo("/login", forceLoad: true);
            return;
        }
        sessions = user!.MyProgram.RegisteredSessions ?? []; // Set student's current session plans
    }

}
