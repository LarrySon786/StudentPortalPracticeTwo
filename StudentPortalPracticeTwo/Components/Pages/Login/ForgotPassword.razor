@page "/reset-password"
@layout ApplicationLayout;
@rendermode InteractiveServer
@using StudentPortalPracticeTwo.Database.Models.Application;
@inject StudentPortalPracticeTwo.Components.Services.Users.UserService userService;


<div class="standard-card">
    @if (submission == false) {
        <p>Please enter your email. You will receive an email with a link to reset your password.</p>
        <EditForm Model="email" OnValidSubmit="HandleSubmit" FormName="Reset Password">
            <DataAnnotationsValidator />
            <div class="form-group">
                <label class="form-label">User Email</label>
                <InputText type="email" class="form-control" @bind-Value="email.Email"/>
                <ValidationMessage For="@(() => email.Email)"/>
            </div>
            <button class="btn btn-primary" type="submit">Get Password Reset Email</button>
        </EditForm>
    }
    else {
        <p>Please check your email to change your password. <a href="/login">Return to Login</a></p>
    }
    
</div>


@code {
    public PreapplyModel email { get; set; } = new();
    public bool submission { get; set; } = false;
    public string errorMessages { get; set; } = "";

    public async Task HandleSubmit() {
        try {
            submission = true;
            errorMessages = "";
            await userService.EmailPasswordReset(email.Email);
        }
        catch (Exception ex) {
            Console.WriteLine($"Could not find an email to reset password. Ex: {ex}");
            errorMessages = ex.Message;
            submission = false;
        }
    }
}