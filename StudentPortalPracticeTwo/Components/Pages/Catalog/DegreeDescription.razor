@page "/catalog/{Id:int}"
@layout ApplicationLayout
@rendermode InteractiveServer
@using StudentPortalPracticeTwo.Database.Models.Degrees
@using StudentPortalPracticeTwo.Components.Ui
@inject StudentPortalPracticeTwo.Components.Services.Admin.DegreeService degreeService

@if (degree == null) {
    <p>No Degree Found...</p>
}
else {
    <div class="landing-body-container">
        <h1>@degree.Name</h1>
        <p>@degree.Description</p>
        <div class="landing-table-container">
            <table class="table default-table">
                <thead>
                    <tr>
                        <th>Course Code</th>
                        <th>Course Name</th>
                        <th>Credit Value</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (Course course in degree.Courses) {
                        <tr>
                            <td>@course.Code</td>
                            <td>@course.Name</td>
                            <td>@course.Credits</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
<div>
    <Footer />
</div>




@code {
    [Parameter] public int Id { get; set; } // Degree Id
    public Degree? degree { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            degree = await degreeService.GetDegreeById(Id);
            if (degree == null) {
                navigationManager.NavigateTo("/catalog", forceLoad: true);
                return;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Could not initialize page. Ex: {ex}");
        }
    }
}

