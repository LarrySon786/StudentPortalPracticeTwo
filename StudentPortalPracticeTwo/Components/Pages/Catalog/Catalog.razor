@page "/catalog"
@layout ApplicationLayout
@rendermode InteractiveServer
@using StudentPortalPracticeTwo.Database.Models.Degrees
@using StudentPortalPracticeTwo.Components.Ui
@inject StudentPortalPracticeTwo.Components.Services.Admin.DegreeService degreeService



<div class="landing-body-container">
    @* <h1>Course Catalog</h1> *@
    <div class="landing-table-container">
        <table class="table default-table table-head">
            <thead>
                <tr>
                    <th>Degrees, Programs, and Courses</th>
                </tr>
            </thead>
            <tbody>
                @foreach(Degree degree in degrees) {
                    <tr>
                        <td>
                            <div class="table-data">
                                <p>@degree.Name</p>
                                <a href="/catalog/@degree.Id" class="btn btn-secondary">Learn More</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<div class="footer-container">
    <Footer />
</div>




@code {
    public List<Degree> degrees { get; set; } = new();

    protected override async Task OnInitializedAsync() {
        try {
            degrees = await degreeService.GetAllDegrees();
        }
        catch (Exception ex) {
            Console.WriteLine($"Could not initialize page. Ex: {ex}");
        }
    }
}

<style>
    .table-head {
        text-align: center;
    }
    th {
        font-size: 1.65rem;
    }
    .table-data {
        padding:24px 48px;
        display:flex;
        justify-content: space-between;
    }
</style>
